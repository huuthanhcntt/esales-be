# === Required ===
PORT=3003

# Inter-service communication (TCP)
NOTIFICATIONS_HOST=notifications
NOTIFICATIONS_PORT=3004

# === Stripe (choose one) ===

# Option 1: Stub mode — no real charges, no Stripe key needed
STRIPE_STUB=true

# Option 2: Real Stripe — set key and remove STRIPE_STUB (or set to false)
# STRIPE_STUB=false
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# === Optional (Infrastructure) ===
# KAFKA_BROKER=kafka:9092
