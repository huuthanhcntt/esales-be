# === Required ===
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/reservations
PORT=3000

# Inter-service communication (TCP)
AUTH_HOST=auth
AUTH_PORT=3002
PAYMENTS_HOST=payments
PAYMENTS_PORT=3003

# === Optional (Infrastructure) ===
# Set KAFKA_BROKER to switch from TCP to Kafka transport
# KAFKA_BROKER=kafka:9092

# Set REDIS_URL to switch from in-memory to Redis cache
# REDIS_URL=redis://redis:6379